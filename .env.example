# Copy to .env.local and fill in the blank values.
# These credentials belong on the trusted backend, never in a game Sprite.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
SPRITE_TOKEN=
RESEND_API_KEY=
RESEND_FROM=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Public HTTPS origin for this app. Local development requires the actual ngrok origin.
# SITE_URL is an app-specific override, not a Vercel system variable.
# Leave it blank on Vercel to use that deployment's system variables.
SITE_URL=
# Comma-separated existing member emails granted admin by npm run setup. Blank grants none.
ADMIN_EMAILS=
CRON_SECRET=
