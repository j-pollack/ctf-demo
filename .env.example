# Copy to .env.local and fill in the blank values.
# These credentials belong on the trusted backend, never in a game Sprite.
OPENROUTER_API_KEY=
SPRITE_TOKEN=
RESEND_API_KEY=
RESEND_FROM=
# Mail for contact messages and reports. Both are needed for mail to be on; set the token for
# Production only. A Fastmail API token with the Email and Email submission scopes, and the address
# mail is sent from and delivered to.
FASTMAIL_API_TOKEN=
CONTACT_EMAIL=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated existing member emails granted admin by npm run setup. Blank grants none.
ADMIN_EMAILS=
CRON_SECRET=
# Deploy-level defaults for the limits an admin can change at /admin. A stored admin value wins,
# then these, then the code default. The Vercel and worker deploys fail when one is missing.
CTF_DAILY_CAP_MICRODOLLARS=10000000
CTF_RUN_BUDGET_MICRODOLLARS=500000
CTF_RUNS_PER_DAY=3
CTF_TOTAL_RUNS_PER_DAY=100
CTF_MONITOR_RUN_ALLOWANCE_MICRODOLLARS=1500000
CTF_FINAL_REVIEW_ALLOWANCE_MICRODOLLARS=1000000
CTF_ENVIRONMENTS_OPEN=10
CTF_NAME_CHECKS_PER_DAY=20
CTF_SESSIONS_PER_RUN=8
CTF_AUTO_CONTINUE_TURNS=8
CTF_RESPONSE_SECONDS=230
CTF_AGENT_EFFORT=low
CTF_INVESTIGATOR_EFFORT=high
