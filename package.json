{
  "name": "tripwire-ctf",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "setup": "node --env-file=.env.local --import tsx scripts/setup.ts",
    "smoke": "node --env-file=.env.local --import tsx scripts/smoke.ts",
    "eval:monitor": "node --env-file-if-exists=.env.local --import tsx scripts/monitor-eval.ts",
    "check:auth": "node --env-file=.env.local --import tsx scripts/auth-check.ts",
    "check:budget": "node --env-file=.env.local --import tsx scripts/budget-check.ts",
    "prepare": "husky",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "npm run lint -- --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "test:coverage": "c8 npm test",
    "worktree": "node --import tsx scripts/worktree.ts",
    "test:integration": "node --import tsx scripts/test-integration.ts",
    "test:integration:coverage": "c8 --reports-dir coverage/integration npm run test:integration"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.99.1",
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@fly/sprites": "^0.2.3",
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.4.8",
    "better-auth": "^1.7.6",
    "next": "^16.3.7",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.31.0",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "c8": "^12.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": "oxlint --deny-warnings",
    "*": "oxfmt --check --no-error-on-unmatched-pattern"
  },
  "c8": {
    "all": true,
    "exclude": [
      "lib/types.ts"
    ],
    "include": [
      "lib/**/*.ts",
      "app/**/*.ts",
      "app/**/*.tsx"
    ],
    "reporter": [
      "text",
      "json-summary"
    ]
  },
  "engines": {
    "node": "24.x"
  }
}
